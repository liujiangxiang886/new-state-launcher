# ============================================================
# 新起点启动器 · 公开仓库忽略规则
#
# 设计原则：默认拒绝。宁可多忽略，也不要靠"我记得别提交那个目录"。
#
# **本文件不使用行尾注释**：git 只把行首（或空白后）的 # 当注释，
# 行尾的 # 会被当成路径的一部分，整条规则静默失效。
# 2026-11-19 踩过一次——`tools/release/   # 说明` 让 5 个写着本机
# 路径与 QQ 号的脚本混进了暂存区。理由一律写在规则**上一行**。
# ============================================================

# ------------------------------------------------------------
# 1. 游戏本体与玩家数据：他人著作权 + 隐私，任何情况都不入库
# ------------------------------------------------------------
# game/ 含 2.9 GB 的 jjxf47.pck，是完整游戏本体。
game/
# 已安装的扩展包
packs/
# 存档档位（含 appdata 与历史备份）
profiles/
# 运行配置，含本机绝对路径
config/
# 真实角色存档备份
_safebox/

# ------------------------------------------------------------
# 2. 反编译产物：游戏本体的衍生内容，不归我们
# ------------------------------------------------------------
# 先全忽略、再按白名单放行；以后新增的反解产物会自动被挡住。
# 只放行整包指纹，不放行源码与索引（index-*.json.gz 各 14.5 MB）。
baseline/*
!baseline/identity-1.45.json
!baseline/identity-4.7.json
!baseline/README.md

扩展开发文档/baseline/*
!扩展开发文档/baseline/identity-*.json

# ------------------------------------------------------------
# 3. 运行时二进制：超过 GitHub 单文件 100 MiB 硬限制
# ------------------------------------------------------------
# runtime/host46/jjxf46.exe  164 MB
# runtime/host47/jjxf47.exe  105 MB
# engines/godot-4.7.2.exe    104 MB
runtime/
engines/*.exe

# ------------------------------------------------------------
# 4. 构建产物与本地环境
# ------------------------------------------------------------
dist/
dist_fix/
dist_new/
build/
builds/
# 发布 zip 走 Releases 附件，不进仓库
release/
_build_tools/
cache/
logs/

# ------------------------------------------------------------
# 5. 第三方内容与历史脚本
# ------------------------------------------------------------
_mod_src/
adapted-1.5/mods/
# 1.4/1.5 时代的一次性发布脚本，写死了本机资源路径
tools/release/
# 素材处理脚本的自备源图目录（官网截图，不入库）
tools/mecha-src/

# ------------------------------------------------------------
# 6. UI 素材：保留并标注（版权归原权利人，见目录内 NOTICE.md）
# ------------------------------------------------------------
# 只排除开发过程截图：含完整界面，是调试留档，不是素材。
assets/ui/mecha/_*.png
assets/ui/mecha/v2/_*.png
assets/ui/mecha/v2/pages/

# ------------------------------------------------------------
# 7. 文档：与他人项目的对比材料
# ------------------------------------------------------------
docs/evidence/

# ------------------------------------------------------------
# 8. 兜底：任何位置的可执行文件与游戏数据包
# ------------------------------------------------------------
# 确有需要入库的二进制用 `git add -f` 单独放行，别改这两行。
*.pck
*.exe

# ------------------------------------------------------------
# 9. Python / 编辑器 / 系统杂物
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

.workbuddy/
.vscode/
.idea/
*.swp

*.log
Thumbs.db
desktop.ini
.DS_Store
